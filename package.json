{
  "name": "wispday-security",
  "version": "0.0.1",
  "description": "Reference subset of WispDay's dependencies - the packages used by the published security layer only. This is NOT a buildable standalone project; the full app depends on many more packages. Listed here so the cryptographic and storage dependencies (and their exact versions) can be verified.",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
      "bip39": "3.1.0",
      "buffer": "*",
      "expo-local-authentication": "55.0.9",
      "expo-secure-store": "55.0.9",
      "react": "19.2.0",
      "react-i18next": "^15.5.3",
      "react-native": "0.83.4",
      "react-native-background-timer": "^2.4.1",
      "react-native-bootsplash": "^6.3.9",
      "react-native-mmkv": "4.3.1",
      "react-native-nitro-file-system": "0.4.0",
      "react-native-quick-crypto": "1.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "codegenConfig": {
    "name": "WispDaySpecs",
    "type": "modules",
    "jsSrcsDir": "src/native-modules",
    "android": {
      "javaPackageName": "com.WispDay"
    }
  }
}
